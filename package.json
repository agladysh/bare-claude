{
  "name": "@agladysh/bare-claude",
  "description": "A convenience wrapper to run Claude Code headless. Supports alternative providers.",
  "version": "0.8.6",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "Alexander Gladysh",
    "email": "agladysh@gmail.com",
    "url": "https://github.com/agladysh/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agladysh/bare-claude.git"
  },
  "bugs": {
    "url": "https://github.com/agladysh/bare-claude/issues"
  },
  "homepage": "https://github.com/agladysh/bare-claude#readme",
  "funding": {
    "url": "https://github.com/sponsors/agladysh"
  },
  "keywords": [
    "ai",
    "agent",
    "sdk",
    "claude",
    "anthropic",
    "automation",
    "code-generation",
    "ollama",
    "llm",
    "byollm"
  ],
  "type": "module",
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./events": "./src/events.ts",
    "./display": "./src/display.ts",
    "./preload": "./src/preload.ts",
    "./preset": "./src/preset.ts",
    "./usage": "./src/usage.ts",
    "./SessionBuilder": "./src/SessionBuilder.ts"
  },
  "bin": {
    "bare-claude": "bin/bare-claude.ts"
  },
  "files": [
    "bin",
    "doc",
    "src",
    "!src/**/*.test.ts",
    "!doc/sessions",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test"
  },
  "engines": {
    "bun": ">=1.3"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@logdna/tail-file": "^4.0.2",
    "arktype": "^2.2.3",
    "deepmerge-ts": "^7.1.5",
    "isbinaryfile": "^6.0.0"
  }
}
