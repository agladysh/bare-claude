#!/usr/bin/env bun
/**
 * Fake `claude`, standing in for the real subprocess `spawnClaude` execs.
 *
 * Never touches a model or the network. `bin/bare-claude.ts`'s own spawn path
 * (`spawnClaude`, `buildArgv`, `buildEnv`) is untouched here — a test drives
 * it by putting this script's directory first on `PATH`, so `Bun.spawn`
 * resolves the literal `claude` in `buildArgv`'s command vector to this file
 * instead of the real binary. What it needs to fake:
 *
 * - `spawnClaude` passes the session id via `--session-id` (fresh run) or
 *   `--resume` (resumed run). This writes `<sessionId>.jsonl` under
 *   `CLAUDE_CONFIG_DIR/projects/<key of its own physical cwd>/`, as the real
 *   binary does — a real run's session transcript, in miniature — so a test
 *   sees whether the path `spawnClaude` reported is the one written.
 * - `--print` is always the flag immediately before the call to action, and
 *   the call to action is always the last argv element (measured constraint
 *   in `buildArgv`), so `argv.at(-1)` recovers it without flag parsing.
 *
 * Behaviour a test needs to control is read from the environment, not argv,
 * so one script serves every scenario in `spawn.test.ts`:
 *
 *   FAKE_CLAUDE_EXIT_CODE      - process exit code. Default `'0'`.
 *   FAKE_CLAUDE_STDOUT         - text written to this process's stdout,
 *                                standing in for what `claude --print` itself
 *                                would print. Default: the call to action
 *                                followed by a canned reply.
 *   FAKE_CLAUDE_WRITE_SESSION  - `'0'` skips writing the session file
 *                                entirely, simulating a crash or a refused
 *                                launch before Claude Code ever created one.
 *                                Default writes it.
 *   FAKE_CLAUDE_VERSION        - what `--version` reports, in the real
 *                                binary's `X.Y.Z (Claude Code)` shape.
 *                                Default `'9.9.9'`.
 *   FAKE_CLAUDE_ECHO_ENV       - name of a variable whose value in this
 *                                process's environment is written to stdout
 *                                as `NAME=<value>` (or `NAME=<unset>`),
 *                                instead of FAKE_CLAUDE_STDOUT. How a test
 *                                sees what the CLI put in the child's env.
 *   FAKE_CLAUDE_ARGV_FILE      - path this process writes its argv to, as a
 *                                JSON array, before anything else. How a test
 *                                sees the flags it was given — and, when the
 *                                file is absent, that it never ran at all.
 *   FAKE_CLAUDE_SLEEP_MS       - milliseconds to wait after writing the
 *                                session file and before exiting, so a test
 *                                can interrupt a run that is still going.
 *   FAKE_CLAUDE_APPEND_EVERY_MS - while sleeping, append one record to the
 *                                session file this often, so a journal that
 *                                stops growing shows its writer has stopped.
 *   FAKE_CLAUDE_READY_FILE     - path written after initial journal records exist; holds the journal path.
 *   FAKE_CLAUDE_PID_FILE       - path this process writes its PID to, once
 *                                its signal handling is in place.
 *   FAKE_CLAUDE_IGNORE_SIGTERM - `'1'` ignores SIGTERM, as a process that
 *                                will not shut down when asked; only SIGKILL
 *                                then ends it.
 *   FAKE_CLAUDE_STDOUT_FIRST   - text written to stdout before the sleep, so
 *                                a stopped run has output to keep.
 *   FAKE_CLAUDE_STDERR         - text written to stderr just before exiting.
 *   FAKE_CLAUDE_WRITE_FILE     - path this process creates, holding `fake`,
 *                                just before exiting: a file someone else put
 *                                where a wrapper means to write one.
 */
import fs from 'node:fs/promises';
import path from 'node:path';

const argv = process.argv.slice(2);

// `claude --version` is what SessionBuilder and --doctor probe; it is the one
// invocation with no session, no config dir and no call to action.
if (argv[0] === '--version') {
  process.stdout.write(`${process.env.FAKE_CLAUDE_VERSION ?? '9.9.9'} (Claude Code)\n`);
  process.exit(0);
}

const argvFile = process.env.FAKE_CLAUDE_ARGV_FILE;
if (argvFile !== undefined) {
  await fs.writeFile(argvFile, JSON.stringify(argv));
}

if (process.env.FAKE_CLAUDE_IGNORE_SIGTERM === '1') {
  process.on('SIGTERM', () => {});
}

const pidFile = process.env.FAKE_CLAUDE_PID_FILE;
if (pidFile !== undefined) {
  await fs.writeFile(pidFile, String(process.pid));
}

function flagValue(name: string): string | undefined {
  const i = argv.indexOf(name);
  return i === -1 ? undefined : argv[i + 1];
}

const sessionId = flagValue('--session-id') ?? flagValue('--resume') ?? 'fake-session';
const callToAction = argv.at(-1) ?? '';

const configDir = process.env.CLAUDE_CONFIG_DIR;
if (configDir === undefined) {
  process.stderr.write('fake claude: CLAUDE_CONFIG_DIR is not set\n');
  process.exit(1);
}

let sessionPath: string | null = null;

if (process.env.FAKE_CLAUDE_WRITE_SESSION !== '0') {
  // Keyed as Claude Code keys it, on the directory this process actually runs
  // in: process.cwd() reads back the physical path whatever alias the spawn
  // was given (observed of the real binary 2026-10-16, see physicalCwd in
  // src/index.ts). The directory is made if missing, as the real one makes
  // it, so a wrapper that keys elsewhere reports a journal that is not there.
  // Short paths only: Claude Code's scheme for very long ones is not modelled.
  const projectDir = path.join(configDir, 'projects', process.cwd().replace(/[^a-zA-Z0-9]/g, '-'));
  await fs.mkdir(projectDir, { recursive: true });

  sessionPath = path.join(projectDir, `${sessionId}.jsonl`);

  // A small, plausible transcript: the prompt echoed back, then a reply.
  // Real enough for TranscriptRenderer to recognize both records.
  const records: object[] = [
    { type: 'user', message: { role: 'user', content: callToAction } },
    {
      type: 'assistant',
      message: {
        model: 'fake-claude', type: 'message', role: 'assistant',
        content: [ { type: 'text', text: 'Done.' } ],
      },
    },
  ];

  for (const record of records) {
    await fs.appendFile(sessionPath, `${JSON.stringify(record)}\n`);
  }
}

const readyFile = process.env.FAKE_CLAUDE_READY_FILE;
if (readyFile !== undefined) {
  await fs.writeFile(readyFile, sessionPath ?? 'no-session');
}

const stdoutFirst = process.env.FAKE_CLAUDE_STDOUT_FIRST;
if (stdoutFirst !== undefined) {
  process.stdout.write(stdoutFirst);
}

const sleepMs = Number(process.env.FAKE_CLAUDE_SLEEP_MS ?? '0');
const appendEveryMs = Number(process.env.FAKE_CLAUDE_APPEND_EVERY_MS ?? '0');
const sleepUntil = Date.now() + sleepMs;
while (Date.now() < sleepUntil) {
  await Bun.sleep(appendEveryMs > 0 ? Math.min(appendEveryMs, sleepUntil - Date.now()) : sleepUntil - Date.now());
  if (appendEveryMs > 0 && sessionPath !== null) {
    await fs.appendFile(sessionPath, `${JSON.stringify({ type: 'progress', at: Date.now() })}\n`);
  }
}

const writeFile = process.env.FAKE_CLAUDE_WRITE_FILE;
if (writeFile !== undefined) {
  await fs.writeFile(writeFile, 'fake');
}

const stderrText = process.env.FAKE_CLAUDE_STDERR;
if (stderrText !== undefined) {
  process.stderr.write(stderrText);
}

const echo = process.env.FAKE_CLAUDE_ECHO_ENV;
process.stdout.write(
  echo !== undefined
    ? `${echo}=${process.env[echo] ?? '<unset>'}\n`
    : process.env.FAKE_CLAUDE_STDOUT ?? `${callToAction}\n\nDone.\n`
);
process.exit(Number(process.env.FAKE_CLAUDE_EXIT_CODE ?? '0'));
